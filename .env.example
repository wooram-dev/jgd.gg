DATABASE_URL="postgresql://jgd:jgd@localhost:5432/jgd"
DIRECT_DATABASE_URL="postgresql://jgd:jgd@localhost:5432/jgd"
BETTER_AUTH_SECRET="replace-with-at-least-32-bytes-of-random-data"
BETTER_AUTH_URL="http://localhost:3000"
DISCORD_CLIENT_ID="replace-with-discord-client-id"
DISCORD_CLIENT_SECRET="replace-with-discord-client-secret"

# Game profiles require the existing bot's token and the target server ID.
# Without both values, game-profile requests fail closed (503).
# DISCORD_BOT_TOKEN="set-in-local-env-or-deployment-secrets"
# TARGET_GUILD_ID="123456789012345678"

# Tests use a dedicated database whose name ends with _test.
DATABASE_URL_TEST="postgresql://jgd:jgd@localhost:5432/jgd_test"
BETTER_AUTH_SECRET_TEST="test-only-secret-at-least-32-bytes-long"
ALLOW_TEST_DATABASE_RESET="false"
